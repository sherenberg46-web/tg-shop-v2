# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS URL where the Mini App is hosted (must be HTTPS for Telegram)
WEBAPP_URL=https://yourdomain.com

# ── Backend ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated CORS allowed origins
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Path to SQLite database file (relative to project root)
DB_PATH=database/shop.db

# URL the bot uses to call the backend API
API_BASE_URL=http://localhost:8000/api/v1
